{
  "name": "@eclipse-glsp-examples/workflow-server",
  "version": "2.8.0",
  "description": "GLSP node server for the workflow example",
  "keywords": [
    "eclipse",
    "graphics",
    "diagram",
    "modeling",
    "visualization",
    "glsp",
    "diagram editor"
  ],
  "homepage": "https://www.eclipse.org/glsp/",
  "bugs": "https://github.com/eclipse-glsp/glsp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-glsp/glsp-server-node.git"
  },
  "license": "(EPL-2.0 OR GPL-2.0 WITH Classpath-exception-2.0)",
  "author": {
    "name": "Eclipse GLSP"
  },
  "contributors": [
    {
      "name": "Eclipse GLSP Project",
      "email": "glsp-dev@eclipse.org",
      "url": "https://projects.eclipse.org/projects/ecd.glsp"
    }
  ],
  "main": "./dist/workflow-glsp-server.js",
  "types": "lib/index",
  "files": [
    "dist",
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node esbuild.js",
    "clean": "rimraf lib tsconfig.tsbuildinfo dist",
    "lint": "eslint ./src",
    "start": "node dist/workflow-glsp-server.js --port 5007",
    "watch": "tsc -w",
    "watch:bundle": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@eclipse-glsp/layout-elk": "2.8.0",
    "@eclipse-glsp/server": "2.8.0",
    "esbuild": "~0.28.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
